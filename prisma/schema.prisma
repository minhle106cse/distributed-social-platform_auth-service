generator client {
  provider = "prisma-client-js"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
}

//////////////////////
// ENUMS
//////////////////////

enum AuthProvider {
  LOCAL
  GOOGLE
  APPLE
}

//////////////////////
// USER (Identity)
//////////////////////

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  isActive  Boolean  @default(true) @map("is_active")
  emailVerified Boolean @default(false) @map("email_verified")
  // True only when created by ProvisionUserHandler (cross-service saga owner
  // provisioning), false for self-registered users (RegisterHandler). Both use
  // the same User.create factory and both start emailVerified:false, so this is
  // the only signal that distinguishes them — needed by the observability-only
  // orphan-detection job (review of ADR-0001, 2026-07-30). Do NOT use
  // emailVerified alone for that: no verification flow exists yet, so it stays
  // false forever for BOTH kinds of user, successful or orphaned.
  provisionedViaSaga Boolean @default(false) @map("provisioned_via_saga")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at") // Soft delete


  authIdentities AuthIdentity[]
  refreshTokens  RefreshToken[]
  roles          UserRole[]
  profile        UserProfile?

  @@index([email])
  @@map("users")
}

//////////////////////
// USER PROFILE
//////////////////////

model UserProfile {
  id          String   @id @default(uuid())
  userId      String   @unique @map("user_id")
  firstName   String?  @map("first_name")
  lastName    String?  @map("last_name")
  displayName String?  @map("display_name")
  avatarUrl   String?  @map("avatar_url")
  phoneNumber String?  @map("phone_number")
  
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

//////////////////////
// AUTH IDENTITIES
//////////////////////

model AuthIdentity {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")

  provider     AuthProvider @default(LOCAL)
  passwordHash String?  @map("password_hash")
  providerId   String?  @map("provider_id") // For Google/Apple ID

  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // 1 user có thể có nhiều auth methods
  @@unique([userId, provider])
  @@unique([provider, providerId])
  @@index([userId])
  @@map("auth_identities")
}

//////////////////////
// REFRESH TOKENS
//////////////////////

model RefreshToken {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")

  tokenHash   String   @unique @map("token_hash")
  expiredAt   DateTime @map("expired_at")

  // rotation / reuse detection
  usedAt      DateTime? @map("used_at")
  revokedAt   DateTime? @map("revoked_at")

  // metadata
  ipAddress   String? @map("ip_address")
  userAgent   String? @map("user_agent")

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

//////////////////////
// RBAC (ROLE-BASED ACCESS CONTROL)
//////////////////////

model Role {
  id          String   @id @default(uuid())
  code        String   @unique // VD: "SUPER_ADMIN", "CONTENT_MODERATOR" — xem SystemRole trong system-permissions.ts
  name        String   // VD: "Super Administrator"
  description String?

  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at") // Soft delete

  // Permission codes are a closed, code-defined catalog (SystemPermission in
  // shared-kernel) — no DB entity for "Permission" needed, same pattern as
  // OrgRolePermission.permission (core-api). Plain string[] column, not a
  // join table: nothing else ever needs to reference a permission by row id.
  permissions String[] @default([])
  users       UserRole[]

  @@map("roles")
}

model UserRole {
  userId       String   @map("user_id")
  roleId       String   @map("role_id")

  createdAt    DateTime @default(now()) @map("created_at")

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role         Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

//////////////////////
// INFRASTRUCTURE
//////////////////////

/// Idempotency cache for the internal AuthProvisioning.ProvisionUser gRPC call —
/// mirrors core-api's IdempotencyRecord (same problem, one layer deeper: that
/// HTTP-level cache only replays a response it actually got to store. If THIS
/// call's own response is lost in flight, core-api's handler throws before ever
/// reaching that cache, so it never learns a user was created here at all. This
/// record is what lets a retry with the SAME key recover the SAME userId
/// instead of orphaning a second provisioned user (review of ADR-0001,
/// 2026-07-30). Deliberately does NOT store the temporary password — a retry
/// gets a freshly re-issued one (ProvisionUserHandler updates the AuthIdentity
/// hash) rather than a plaintext secret persisted at rest for later replay.
model GrpcIdempotencyRecord {
  key       String   @id // core-api's X-Idempotency-Key, threaded through the RPC
  userId    String   @map("user_id")
  // Stored so a key collision across two DIFFERENT requests (client bug, or
  // reused key across admins) is detectable instead of silently reissuing a
  // live temp password for someone else's account — see ProvisionUserHandler.
  email     String
  createdAt DateTime @default(now()) @map("created_at")
  expiresAt DateTime @map("expires_at")

  @@index([expiresAt])
  @@map("grpc_idempotency_records")
}